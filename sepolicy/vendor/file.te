# Dolby Media Setting (DMS) HAL - DAP parameter store below /data/vendor/dolby.
# Previously unlabelled, so it fell through to the generic vendor_data_file
# type and hal_dolby_dms only worked because the domain was permissive.
type hal_dolby_dms_data_file, data_file_type, file_type;
