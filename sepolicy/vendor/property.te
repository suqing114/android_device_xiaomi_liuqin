# vendor_fp_prop and vendor_fp_info_prop are now provided by
# device/xiaomi/sm8450-common/sepolicy/vendor/property.te.

# Dolby Media Setting (DMS) HAL - persist.vendor.dolby.* / vendor.dolby.*
# (loglevel, dump.output, dumpyuv, sync.output, is). Without a dedicated type
# these fell through to the generic vendor property type and the HAL could not
# write them.
vendor_public_prop(vendor_dolby_prop)
